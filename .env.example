# ==========================================
# DocuMind - Production Configuration
# ==========================================

# OpenAI API Configuration
# If not provided, DocuMind falls back to high-fidelity local vectorizer & mock synthesizer
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage & Database Directories
DOCUMIND_DATA_DIR=./data
CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads

# Hybrid Retrieval Settings
# Alpha: Weight for dense vector search (0.0 = pure BM25, 1.0 = pure dense, 0.5 = balanced)
HYBRID_ALPHA=0.5
RETRIEVAL_TOP_K=10
MMR_DIVERSITY_LAMBDA=0.7
MMR_FINAL_K=5

# PDF Ingestion & Semantic Chunking
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# Server Configuration
DOCUMIND_HOST=0.0.0.0
DOCUMIND_PORT=8000
DEBUG=False
